{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "ClefCraftDatabaseConnectionString": ""
  },

  "AIService": {
    "BaseUrl": "http://localhost:8000"
  },

  "EmailSettings": {
    "ApiKey": "",
    "FromAddress": "no-reply@clefcraft.com",
    "FromName": "Clef Craft"
  },

  "JwtSettings": {
    "Key": "",
    "Issuer": "ClefCraft.Api",
    "Audience": "ClefCraftUser",
    "DurationInMinutes": 15
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}